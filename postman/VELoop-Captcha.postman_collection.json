{
  "info": {
    "_postman_id": "veloop-captcha-earn-clean-20261003",
    "name": "VELoop CAPTCHA Earn API",
    "description": "VELoop CAPTCHA Earn API collection. No real JWT, password, MongoDB URI, API key, or other secret is embedded. Set email/password/token variables at runtime.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "challengeId",
      "value": ""
    },
    {
      "key": "selectedOption",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"VELoop Test User\",\n  \"email\": \"{{$randomEmail}}\",\n  \"password\": \"{{$randomPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "event": [
              {
                "listen": "test",
                "script": {
                  "type": "text",
                  "exec": [
                    "const data = pm.response.json();",
                    "if (data.token) pm.collectionVariables.set('token', data.token);",
                    "pm.test('Login returned a response', () => pm.expect(pm.response.code).to.be.oneOf([200,400,401]));"
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "name": "02 - CAPTCHA Main Flow",
      "item": [
        {
          "name": "Generate Challenge",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/captcha/generate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "captcha",
                "generate"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text",
                "exec": [
                  "const json = pm.response.json();",
                  "const data = json.data || json;",
                  "if (data.challengeId) pm.collectionVariables.set('challengeId', data.challengeId);",
                  "if (Array.isArray(data.options) && data.options[0]) pm.collectionVariables.set('selectedOption', data.options[0]);",
                  "pm.test('Exactly 4 options', () => pm.expect(data.options).to.have.lengthOf(4));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get CAPTCHA Image",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/captcha/image/{{challengeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "captcha",
                "image",
                "{{challengeId}}"
              ]
            }
          }
        },
        {
          "name": "Submit CAPTCHA",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/captcha/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "captcha",
                "submit"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"{{challengeId}}\",\n  \"selectedOption\": \"{{selectedOption}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Claim Reward",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/captcha/claim",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "captcha",
                "claim"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"{{challengeId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Skip CAPTCHA",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/captcha/skip",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "captcha",
                "skip"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"{{challengeId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "CAPTCHA History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/captcha/history?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "captcha",
                "history"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "03 - Wallet",
      "item": [
        {
          "name": "Get Gems Balance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/wallet/gems",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wallet",
                "gems"
              ]
            }
          }
        },
        {
          "name": "Get Gem Transactions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/wallet/transactions?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wallet",
                "transactions"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "04 - Negative & Security Tests",
      "item": [
        {
          "name": "Unauthorized Generate",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/captcha/generate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "captcha",
                "generate"
              ]
            }
          }
        },
        {
          "name": "Invalid JWT",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "invalid",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/captcha/generate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "captcha",
                "generate"
              ]
            }
          }
        },
        {
          "name": "Missing Selected Option",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/captcha/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "captcha",
                "submit"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"{{challengeId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Invalid Option",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/captcha/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "captcha",
                "submit"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"{{challengeId}}\",\n  \"selectedOption\": \"NOT-ONE-OF-THE-FOUR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Duplicate Claim",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/captcha/claim",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "captcha",
                "claim"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"{{challengeId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}