                "submit"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"{{challengeId}}\",\n  \"selectedOption\": \"{{selectedOption}}\"\n  }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "Requires secondToken to belong to a different user. Use a challenge created by the first user. The authenticated identity must control access, not a request-body userId.",
          "event": [
