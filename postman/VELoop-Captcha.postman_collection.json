                  "language": "json"
                }
              }
            }
          },
          "description": "Run this immediately after a successful verification of the same challenge.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.test('Completed challenge cannot be verified again', () => pm.expect(pm.response.code).to.equal(409));",
                  "pm.test('Correct duplicate-verification error code', () => pm.expect(data.code).to.equal('CHALLENGE_ALREADY_COMPLETED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Concurrent Verification (10 Requests)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          },
          "description": "Sends 10 parallel verification requests for the same challenge using pm.sendRequest. Run against a fresh active challenge only. Inspect Postman Console; expected behavior is that only one request can transition the challenge from active to completed, while the others are rejected.",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text",
                "exec": [
                  "const token = pm.collectionVariables.get('token');",
                  "const challengeId = pm.collectionVariables.get('challengeId');",
                  "const selectedOption = pm.collectionVariables.get('selectedOption');",
                  "if (!token || !challengeId || !selectedOption) throw new Error('Set token, challengeId and selectedOption first.');",
                  "const url = pm.variables.replaceIn('{{baseUrl}}/api/captcha/submit');",
                  "for (let i = 0; i < 10; i++) {",
                  "  pm.sendRequest({",
                  "    url,",
                  "    method: 'POST',",
                  "    header: {'Content-Type': 'application/json', 'Authorization': `Bearer ${token}`},",
                  "    body: {mode:'raw',raw: JSON.stringify({challengeId, selectedOption}), options:{raw:{language:'json'}}}",
                  "  }, (err, res) => {",
                  "    if (err) console.log(`Concurrent verification ${i+1}: ERROR`, err);",
                  "    else console.log(`Concurrent verification ${i+1}: HTTP ${res.code}`, res.json());",
                  "  });",
                  "}",
                  "console.log('Started 10 parallel verification requests. Inspect the Postman Console for the response distribution. Expected: 1 success + remaining requests rejected as replay/completed.');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text",
                "exec": [
                  "pm.test('Probe request completed', () => pm.expect(pm.response.code).to.equal(200));",
                  "console.log('Open Postman Console (View -> Show Postman Console) to inspect the 10 concurrent verification responses.');"
                ]
              }
            }
          ]
        },
        {
          "name": "Rate Limit Probe (Local Only)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          },
          "description": "LOCAL-DEVELOPMENT ONLY. The backend currently limits /api traffic to 200 requests per 15 minutes. Do not run this high-volume probe repeatedly against the production deployment.",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text",
                "exec": [
                  "const token = pm.collectionVariables.get('token');",
                  "if (!token) throw new Error('Login first so the generated endpoint requests are authenticated.');",
                  "const url = pm.variables.replaceIn('{{baseUrl}}/api/captcha/generate');",
                  "for (let i = 0; i < 205; i++) {",
                  "  pm.sendRequest({",
                  "    url, method:'GET', header:{'Authorization':`Bearer ${token}`}",
                  "  }, (err, res) => {",
                  "    if (err) console.log(`Rate-limit request ${i+1}: ERROR`, err);",
                  "    else if (res.code === 429) console.log(`Rate-limit threshold reached at request ${i+1}: HTTP 429`);",
                  "  });",
                  "}",
                  "console.log('Started 205 rate-limit probe requests. Run locally only. Do NOT use this request repeatedly against the live Render service.');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text",
                "exec": [
                  "pm.test('Probe request completed', () => pm.expect(pm.response.code).to.equal(200));",
                  "console.log('Inspect Postman Console for HTTP 429 responses after the configured 200-request window is exceeded.');"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
