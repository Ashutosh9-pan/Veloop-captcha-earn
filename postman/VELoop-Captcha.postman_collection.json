        {
          "name": "Duplicate Verification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/captcha/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "captcha",
                "submit"
