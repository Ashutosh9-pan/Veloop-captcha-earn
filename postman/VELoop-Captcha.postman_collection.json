              "raw": "{\n  \"challengeId\": \"{{expiredChallengeId}}\",\n  \"selectedOption\": \"{{selectedOption}}\"\n  }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "Set expiredChallengeId to a challenge that has passed its 5-minute expiry. This request should return HTTP 410.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.test('Expired challenge is rejected', () => pm.expect(pm.response.code).to.equal(410));",
                  "pm.test('Correct expiry error code', () => pm.expect(data.code).to.equal('CHALLENGE_EXPIRED'));"
                ]
              }
            }
          ]
        },
