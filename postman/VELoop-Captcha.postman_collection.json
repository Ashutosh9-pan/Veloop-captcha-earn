        {
          "name": "Fake Reward",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/captcha/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "captcha",
                "submit"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"{{challengeId}}\",\n  \"selectedOption\": \"{{selectedOption}}\",\n  \"rewardAmount\": 9999\n  }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "Sends a forged rewardAmount. The backend must calculate the reward from its own configuration and ignore this client-controlled value.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.test('Request is processed without trusting fake reward', () => pm.expect(pm.response.code).to.be.oneOf([200,400,409,410]));",
                  "pm.test('Backend returns a reward object when verification succeeds', () => { if (pm.response.code === 200) pm.expect(data.reward).to.exist; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Fake isCorrect",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/captcha/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "captcha",
                "submit"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"{{challengeId}}\",\n  \"selectedOption\": \"{{wrongOption}}\",\n  \"isCorrect\": true\n  }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "Set wrongOption to one of the issued options before running. The forged isCorrect=true field must not make a wrong answer correct.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.test('Backend does not trust client isCorrect', () => pm.expect(pm.response.code).to.be.oneOf([200,400,409,410]));",
                  "pm.test('Forged isCorrect does not appear as an authoritative field', () => { if (pm.response.code === 200) pm.expect(data).to.not.have.property('isCorrect'); });"
                ]
              }
            }
          ]
        },
