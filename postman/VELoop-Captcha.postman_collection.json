{
  "info": {
    "_postman_id": "veloop-captcha-earn-clean-20261003",
    "name": "VELoop CAPTCHA Earn API",
    "description": "VELoop CAPTCHA Earn API collection. No real JWT, password, MongoDB URI, API key, or other secret is embedded. Set email/password/token variables at runtime.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "challengeId",
      "value": ""
    },
    {
      "key": "selectedOption",
      "value": ""
    },
    {
      "key": "secondToken",
      "value": ""
    },
    {
      "key": "secondChallengeId",
      "value": ""
    },
    {
      "key": "wrongOption",
      "value": ""
    },
    {
      "key": "expiredChallengeId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"VELoop Test User\",\n  \"email\": \"{{$randomEmail}}\",\n  \"password\": \"{{$randomPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "event": [
              {
                "listen": "test",
                "script": {
                  "type": "text",
                  "exec": [
                    "const data = pm.response.json();",
                    "if (data.token) pm.collectionVariables.set('token', data.token);",
                    "pm.test('Login returned a response', () => pm.expect(pm.response.code).to.be.oneOf([200,400,401]));"
                  ]
                }
              }
            ]
          }
        }
      ]
    },
